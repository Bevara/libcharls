{
    "name": "libcharls",
    "version": "1.0.2",
    "description": "JPEG-LS image decoder",
    "filters":["jlsdec"],
    "help": "This filter decodes JPEG-LS (ISO/IEC 14495-1) images using CharLS.",
    "support": [
        "image"
    ],
    "sources":"https://bevara.ddns.net/sources/libcharls.accessor",
    "filter_source":{
        "jlsdec" : "dec_jls.c"
    },
    "extension":{
      "jls" : "img"
    },
    "using": ["mm_solver_1.0.1"],
    "patents": {
        "status": "royalty-free",
        "note": "JPEG-LS, royalty-free licence from HP",
        "checked": "2026-10-16"
    }
}
